# 复制为 .env 后，把占位符换成你自己申请的 Key。不要提交 .env，不要使用别人的 Key。
# DeepSeek 控制台（看用量、创建 API Key）：https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ASR 配置
ASR_MODEL=small
ASR_LANGUAGE=en

# 翻译引擎（deepseek / dashscope / baidu / tencent / alibaba / ollama；也可在应用「设置」里切换）
# TRANSLATE_PROVIDER=baidu

# 逐句翻译带前 N 句背景（背景式上下文：当前句单独翻译，前 N 句英中对照注入 prompt
# 供指代/话题理解，维持逐句 1:1 对齐；0=关闭）。仅 LLM 类引擎生效。
# TRANSLATE_CONTEXT=2

# 阿里云 / 百度 / 腾讯等机器翻译申请步骤：
# https://blog.csdn.net/weixin_44253490/article/details/126365385
# 上课建议仍用 DeepSeek；下面这些可后填。

# 阿里百炼 DashScope（OpenAI 兼容，qwen 模型，新用户免费额度）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_MODEL=qwen-turbo

# 百度翻译开放平台（标准版免费 5 万字符/月，个人认证 100 万）：https://fanyi-api.baidu.com
BAIDU_APPID=your-baidu-appid
BAIDU_SECRET=your-baidu-secret

# 腾讯云机器翻译（每月 500 万字符）：https://cloud.tencent.com/product/tmt
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# 阿里云机器翻译（新人免费额度）：https://www.aliyun.com/product/ai/alimt
ALI_ACCESS_KEY_ID=your-ali-access-key-id
ALI_ACCESS_KEY_SECRET=your-ali-access-key-secret

# Ollama 本地/远程翻译（免费、断网可用）：本机默认 http://127.0.0.1:11434/v1
# 配合 Tailscale 可指向其他机器：OLLAMA_BASE_URL=http://100.x.y.z:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b-instruct
